# Copy to /opt/quizproject/.env on the droplet (chmod 600) and replace every
# placeholder. This file never goes to GitHub: the deploy workflow only copies
# the compose files, and the secrets stay on the droplet.

# ":80" = plain HTTP on the droplet's IP. A hostname (quiz.example.com) turns on
# automatic HTTPS; its DNS A record must already point at the droplet.
SITE_ADDRESS=:80

# Exactly what a browser shows in the address bar: used as the CORS origin.
# http://164.92.163.71 for the IP, https://quiz.example.com for a hostname.
PUBLIC_ORIGIN=http://164.92.163.71

DB_USERNAME=quiz_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# openssl rand -base64 32
JWT_SECRET=replace-with-base64-encoded-32-byte-secret

# openssl rand -hex 24
REDIS_PASSWORD=replace-with-a-long-random-password
